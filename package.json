{
  "name": "@ktern/design-system",
  "version": "0.1.0",
  "private": false,
  "description": "A modern, accessible React component library with dark mode, theming, and TypeScript support",
  "keywords": [
    "react",
    "components",
    "design-system",
    "ui-library",
    "tailwind",
    "typescript",
    "dark-mode"
  ],
  "author": "Ktern Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/ktern-design-system"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "**/*.sass"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:lib": "vite build --config vite.config.lib.ts && tsc --project tsconfig.lib.json",
    "pack:local": "npm run build:lib && npm pack",
    "start": "next start",
    "lint": "next lint",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "npx chromatic --only-changed",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "generate": "plop",
    "prepare": "husky"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.561.0",
    "next": "^14.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@eslint/eslintrc": "^3.3.3",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-switch": "^1.2.6",
    "@storybook/addon-a11y": "^10.1.8",
    "@storybook/addon-docs": "^10.1.8",
    "@storybook/addon-links": "^10.1.8",
    "@storybook/react": "^10.1.8",
    "@storybook/react-vite": "^10.1.8",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/ui": "^4.0.15",
    "autoprefixer": "^10.4.20",
    "chromatic": "^13.3.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "glob": "^13.0.0",
    "husky": "^9.1.7",
    "jsdom": "^27.3.0",
    "plop": "^4.0.4",
    "postcss": "^8.4.49",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.1.8",
    "stylelint-config-standard": "^39.0.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.15"
  }
}
