import { describe, it, expect, vi } from 'vitest';
import { render, screen } from '@testing-library/react';
import userEvent from '@testing-library/user-event';
import React from 'react';
import { {{pascalCase name}} } from './{{pascalCase name}}';

describe('{{pascalCase name}}', () => {
describe('Rendering', () => {
it('renders correctly', () => {
render(<{{pascalCase name}}>Test Content</{{pascalCase name}}>);
expect(screen.getByText('Test Content')).toBeInTheDocument();
});

it('applies custom className', () => {
const { container } = render(
<{{pascalCase name}} className="custom-class">Content</{{pascalCase name}}>
);
expect(container.firstChild).toHaveClass('custom-class');
});

it('renders children correctly', () => {
render(
<{{pascalCase name}}>
    <span data-testid="child">Child Element</span>
</{{pascalCase name}}>
);
expect(screen.getByTestId('child')).toBeInTheDocument();
});
});

describe('Variants', () => {
it('renders default variant', () => {
const { container } = render(<{{pascalCase name}} variant="default">Default</{{pascalCase name}}>);
expect(container.firstChild).toBeInTheDocument();
});

it('renders outline variant', () => {
const { container } = render(<{{pascalCase name}} variant="outline">Outline</{{pascalCase name}}>);
expect(container.firstChild).toBeInTheDocument();
});
});

describe('Accessibility', () => {
it('forwards ref correctly', () => {
const ref = vi.fn();
render(<{{pascalCase name}} ref={ref}>Content</{{pascalCase name}}>);
expect(ref).toHaveBeenCalled();
});

it('passes through HTML attributes', () => {
const { container } = render(
<{{pascalCase name}} data-testid="test-id" aria-label="Test Label">
    Content
</{{pascalCase name}}>
);
expect(container.firstChild).toHaveAttribute('data-testid', 'test-id');
expect(container.firstChild).toHaveAttribute('aria-label', 'Test Label');
});
});
});